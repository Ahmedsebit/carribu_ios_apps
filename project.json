{
  "name": "Carribu",
  "options": { "deploymentTarget": { "iOS": "17.0" }, "bundleIdPrefix": "com.carribu" },
  "configs": { "Debug": "debug", "Release": "release" },
  "configFiles": { "Debug": "Local.xcconfig", "Release": "Local.xcconfig" },
  "settings": {
    "base": {
      "SWIFT_VERSION": "5.0",
      "MARKETING_VERSION": "1.0.0",
      "CURRENT_PROJECT_VERSION": "1",
      "CODE_SIGN_STYLE": "Automatic",
      "TARGETED_DEVICE_FAMILY": "1,2",
      "ENABLE_USER_SCRIPT_SANDBOXING": "YES"
    },
    "configs": {
      "Debug": { "APS_ENVIRONMENT": "development" },
      "Release": { "APS_ENVIRONMENT": "production" }
    }
  },
  "packages": {
    "Firebase": { "url": "https://github.com/firebase/firebase-ios-sdk.git", "from": "12.0.0" }
  },
  "targetTemplates": {
    "CarribuApp": {
      "type": "application",
      "platform": "iOS",
      "dependencies": [
        { "package": "Firebase", "product": "FirebaseCore" },
        { "package": "Firebase", "product": "FirebaseMessaging" }
      ]
    }
  },
  "targets": {
    "CarribuDriver": {
      "templates": ["CarribuApp"],
      "sources": ["Shared", "DriverApp.swift", "DriverViews.swift", { "path": "DriverResources", "buildPhase": "resources", "excludes": [".gitkeep"] }],
      "settings": { "base": { "PRODUCT_BUNDLE_IDENTIFIER": "com.carribu.driverios" } },
      "entitlements": {
        "path": "Driver.entitlements",
        "properties": { "aps-environment": "$(APS_ENVIRONMENT)" }
      },
      "info": {
        "path": "DriverInfo.plist",
        "properties": {
          "CFBundleDisplayName": "Carribu Driver",
          "UILaunchScreen": {},
          "CarribuAPIBaseURL": "$(CARRIBU_API_BASE_URL)",
          "CarribuUpdateURL": "$(CARRIBU_UPDATE_URL)",
          "FirebaseAppDelegateProxyEnabled": false,
          "NSLocationWhenInUseUsageDescription": "Share this phone's location during an active trip when the vehicle has no linked Traccar tracker.",
          "NSLocationAlwaysAndWhenInUseUsageDescription": "Keep parents informed of the active trip's location while Carribu is in the background.",
          "UIBackgroundModes": ["location", "remote-notification"]
        }
      }
    },
    "CarribuParent": {
      "templates": ["CarribuApp"],
      "sources": ["Shared", "ParentApp.swift", "ParentViews.swift", { "path": "ParentResources", "buildPhase": "resources", "excludes": [".gitkeep"] }],
      "settings": { "base": { "PRODUCT_BUNDLE_IDENTIFIER": "com.carribu.parentios" } },
      "entitlements": {
        "path": "Parent.entitlements",
        "properties": { "aps-environment": "$(APS_ENVIRONMENT)" }
      },
      "info": {
        "path": "ParentInfo.plist",
        "properties": {
          "CFBundleDisplayName": "Carribu Parent",
          "UILaunchScreen": {},
          "CarribuAPIBaseURL": "$(CARRIBU_API_BASE_URL)",
          "CarribuUpdateURL": "$(CARRIBU_UPDATE_URL)",
          "FirebaseAppDelegateProxyEnabled": false,
          "NSLocationWhenInUseUsageDescription": "Use your current location to choose your child's pickup point.",
          "UIBackgroundModes": ["remote-notification"]
        }
      }
    },
    "CarribuDriverTests": {
      "type": "bundle.unit-test",
      "platform": "iOS",
      "sources": ["Tests"],
      "settings": { "base": { "SWIFT_ACTIVE_COMPILATION_CONDITIONS": "$(inherited) DRIVER_TESTS", "GENERATE_INFOPLIST_FILE": "YES" } },
      "dependencies": [{ "target": "CarribuDriver" }]
    },
    "CarribuParentTests": {
      "type": "bundle.unit-test",
      "platform": "iOS",
      "sources": ["Tests"],
      "settings": { "base": { "GENERATE_INFOPLIST_FILE": "YES" } },
      "dependencies": [{ "target": "CarribuParent" }]
    }
  },
  "schemes": {
    "CarribuDriver": {
      "build": { "targets": { "CarribuDriver": "all" } },
      "test": { "targets": ["CarribuDriverTests"] }
    },
    "CarribuParent": {
      "build": { "targets": { "CarribuParent": "all" } },
      "test": { "targets": ["CarribuParentTests"] }
    }
  }
}
